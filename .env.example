# ── Neon (database) ──────────────────────────────────────────────
# From Neon dashboard → Connect → copy the connection string (use "Pooled" for Render)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Render (backend web service) ───────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# Must match your Render service URL (with trailing slash)
Jwt__Issuer=https://campusbridge-api.onrender.com/

# Must match your Vercel frontend URL (with trailing slash)
Jwt__Audience=https://your-app.vercel.app/

# Generate a long random secret (32+ characters). Render can auto-generate this.
Jwt__Key=your-secret-key-at-least-32-characters-long

# Comma-separated list of allowed frontend origins
Cors__AllowedOrigins=https://your-app.vercel.app,http://localhost:3000

# ── Local development (docker-compose Postgres) ────────────────────
# ConnectionStrings__GeneralConnection=Host=localhost;Port=5432;Database=campusbridge;Username=postgres;Password=postgres
